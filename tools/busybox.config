CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_CROSS_COMPILER_PREFIX=""
CONFIG_EXTRA_CFLAGS="-target i686-unknown-linux-musl -Os -DBB_GLOBAL_CONST="
CONFIG_EXTRA_LDFLAGS="-fuse-ld=lld"
CONFIG_HUSH=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_SH_IS_ASH=n
CONFIG_ASH=n
CONFIG_SH_IS_HUSH=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_BC=y
CONFIG_DC=y
CONFIG_DATE=y
CONFIG_TIME=y
CONFIG_SLEEP=y
CONFIG_LS=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_PWD=y
CONFIG_ECHO=y
CONFIG_CLEAR=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_LFS=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_TEST=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
